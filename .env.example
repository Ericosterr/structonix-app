# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://structonixsistem.com

# Notion CMS (blog)
# Create an integration at https://www.notion.so/my-integrations
# Share your blog database with the integration before deploying.
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Contact form — Resend (https://resend.com)
# Server-only. Never expose RESEND_API_KEY to the client.
RESEND_API_KEY=
RESEND_FROM="Structonix <info@structonixsistem.com>"

# Google reCAPTCHA v3 (optional but recommended in production)
# Client-visible site key:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only secret:
RECAPTCHA_SECRET_KEY=
